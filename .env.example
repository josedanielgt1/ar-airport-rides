# Variables de entorno de la función /api/reserve (Vercel → Project Settings → Environment Variables).
# Nunca subas valores reales al repositorio. Copia este archivo como .env solo para pruebas locales
# con `vercel dev`; `npm run dev` usa una SIMULACIÓN que no envía correos y no las necesita.

# Clave de API de Resend (https://resend.com/api-keys). Empieza con "re_".
RESEND_API_KEY=

# A quién llegan las solicitudes de reserva (el correo del cliente).
# Con el remitente de pruebas de Resend solo se puede enviar al correo dueño de la cuenta.
RESERVATION_TO_EMAIL=

# Remitente. Para producción debe ser de un dominio verificado en Resend,
# p. ej. "AR Airport Rides <reservas@tudominio.com>". Para pruebas: "onboarding@resend.dev".
RESERVATION_FROM_EMAIL=

# Formas de pago del cliente. NO se muestran en el sitio: solo aparecen en el mensaje de confirmación
# que el chofer envía al pasajero desde el correo de la reserva. Todas son opcionales; la que falte
# o no sea válida se omite del mensaje.
# Venmo: enlace https de venmo.com (perfil o QR). Ej.: https://venmo.com/u/usuario
PAY_VENMO_URL=
# Cash App: enlace https de cash.app. Ej.: https://cash.app/$tucashtag
PAY_CASHAPP_URL=
# Zelle: correo o teléfono registrado en Zelle (texto).
PAY_ZELLE=

# Clave para cifrar el enlace "Enviar confirmación con QR" del correo del chofer: 32 caracteres o más, aleatoria.
# Genérala con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Sin ella (o si tiene menos de 32 caracteres) la reserva sigue funcionando, pero el botón de confirmación no
# aparece y el log de Vercel avisa "CONFIRM_SECRET tiene menos de 32 caracteres". Usa valores distintos en
# Production y Preview, márcala como Sensitive y no la compartas. Los enlaces vencen a las 24 h.
CONFIRM_SECRET=
# (Opcional, solo durante una rotación) La clave ANTERIOR: sirve para abrir los enlaces que ya se enviaron con
# ella (nunca cifra enlaces nuevos). Rotar: 1) copia el valor actual de CONFIRM_SECRET aquí, 2) pon una clave
# nueva en CONFIRM_SECRET, 3) redeploy, 4) pasadas 24 h borra esta variable y vuelve a desplegar.
# Si la anterior tiene menos de 32 caracteres se ignora (esos enlaces dejan de funcionar).
CONFIRM_SECRET_PREVIOUS=
# (Opcional) URL pública del sitio, p. ej. https://tudominio.com. Si falta se usa la URL de producción de Vercel.
SITE_URL=
# (Opcional) Placa del vehículo para el correo de confirmación al pasajero ("Your ride: … · Texas plate ABC 1234").
# NO va en el repo. El chofer la ve prellenada en /api/confirm y puede cambiarla o borrarla antes de enviar.
# Se muestra en mayúsculas ("abc1234" → "ABC 1234"); máx. 12 caracteres (letras, números, espacio, guion).
# Sin ella el campo aparece vacío y el correo solo dice el vehículo.
VEHICLE_PLATE=
# (Opcional) Descripción del vehículo; si existe, reemplaza la de src/config.js (VEHICLE_DEFAULT) en ambos idiomas.
# Máx. 60 caracteres, una línea, sin HTML. Ej.: Black Ford Expedition XLT
# OJO: la miniatura del correo (public/media/email-vehicle.jpg, la Expedition del cliente) sale cuando la descripción
# final coincide con ESTA. Si pones aquí otro carro, cambia también esa foto (o la miniatura mostraría el carro equivocado).
VEHICLE_DESCRIPTION=
# (Opcional) Nombre del conductor para el correo de confirmación al pasajero ("Your chauffeur: Abraham Rojas").
# Si existe, reemplaza DRIVER_DEFAULT_NAME de src/config.js. El chofer lo ve prellenado en /api/confirm y puede
# cambiarlo o borrarlo (vacío = sin esa línea). Máx. 60 caracteres: letras (con tildes/ñ), espacios y . ' -
DRIVER_NAME=
# (Opcional) Clave de Google Maps (Static Maps API) para mostrar el mapa de la ruta dentro del correo del pasajero.
# Sin ella el correo solo lleva los botones que abren el mapa. Restríngela a la API Static Maps en Google Cloud.
GOOGLE_MAPS_API_KEY=
